<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <AssemblyName>TORMercenaryCareerOverhaul</AssemblyName>
    <RootNamespace>TORMercenaryCareerOverhaul</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>

    <BannerlordDir Condition=" '$(BannerlordDir)' == '' AND '$(BANNERLORD_DIR)' != '' ">$(BANNERLORD_DIR)\</BannerlordDir>
    <BannerlordDir Condition=" '$(BannerlordDir)' == '' AND Exists('$(MSBuildProjectDirectory)\..\..\..\bin\Win64_Shipping_Client\TaleWorlds.Core.dll') ">$(MSBuildProjectDirectory)\..\..\..\</BannerlordDir>
    <BannerlordDir Condition=" '$(BannerlordDir)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\bin\Win64_Shipping_Client\TaleWorlds.Core.dll') ">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\</BannerlordDir>
    <GameBinDir>$(BannerlordDir)bin\Win64_Shipping_Client\</GameBinDir>
    <TORBinDir>$(BannerlordDir)Modules\TOR_Core\bin\Win64_Shipping_Client\</TORBinDir>
    <HarmonyBinDir>$(BannerlordDir)Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\</HarmonyBinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameBinDir)TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection">
      <HintPath>$(GameBinDir)TaleWorlds.Core.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBinDir)TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBinDir)TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameBinDir)TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameBinDir)TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameBinDir)TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameBinDir)TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameBinDir)TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ModuleManager">
      <HintPath>$(GameBinDir)TaleWorlds.ModuleManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TOR_Core">
      <HintPath>$(TORBinDir)TOR_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyBinDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
